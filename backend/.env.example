# Copy this file to .env before running the application.
APP_NAME=WeatherGPT
APP_VERSION=1.0.0
DEBUG=true

# Add your Gemini API key locally. Never commit backend/.env.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_SEARCH_GROUNDING=true

# Optional Gemini voice provider. Keep GEMINI_API_KEY on the backend only.
VOICE_PROVIDER=gemini
GEMINI_VOICE_MODEL=gemini-2.5-flash
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
GEMINI_TTS_VOICE=Kore

# Optional PostgreSQL + PostGIS persistence. Leave empty to use in-memory chat.
DATABASE_URL=
STORAGE_MODE=json
JSON_DATA_FILE=backend/data/weathergpt.json
# Add your deployed frontend URL(s), comma-separated, for example:
# CORS_ALLOWED_ORIGINS=https://weathergpt.pages.dev
CORS_ALLOWED_ORIGINS=

# Official India disaster alerts. SACHET publishes CAP/RSS alerts; enable after
# confirming feed access and usage terms for your deployment.
SACHET_ALERTS_ENABLED=false
SACHET_ALERTS_URL=https://sachet.ndma.gov.in/cap_public_website/rss/rss_india.xml
